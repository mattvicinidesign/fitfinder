# Supabase project credentials (Project Settings → API).
# Copy to .env.local. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for Settings → Delete account (Project Settings → API).
# Never expose this to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI is NOT configured here — it lives in supabase/.env (see supabase/.env.example).
# Edge Functions read OPENAI_API_KEY from Supabase secrets, not from the Next.js app.

# QA: force registered scoring while still using a guest/anonymous session.
# Also auto-uploads web/public/qa/Matt_Vicini_Product_Designer_Resume_2026C.pdf
# on Analyze (once per browser session; requires sign-in).
NEXT_PUBLIC_QA_REGISTERED_SCORING=true
