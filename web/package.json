  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:capacitor": "node scripts/prepare-recommended-jobs-bundled.mjs && CAPACITOR_BUILD=true next build",
    "postbuild:capacitor": "npx cap sync ios",
    "start": "next start",
