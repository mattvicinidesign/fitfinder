# Secrets for Edge Functions. Copy to supabase/.env and fill in.
# Locally: `supabase functions serve --env-file ./supabase/.env`
# In the cloud: `supabase secrets set --env-file ./supabase/.env`

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the
# Supabase runtime and do not need to be set here.
